# Runtime
GATEWAY_ENVIRONMENT=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO

# SQLite
GATEWAY_DATABASE_PATH=./data/gateway.db

# API-key security
# Replace outside disposable local development.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
GATEWAY_API_KEY_PEPPER=development-only-change-me

# Ollama provider — configured by the operator, never by the API caller.
GATEWAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
GATEWAY_OLLAMA_ALLOWED_HOSTS=127.0.0.1,localhost,::1
GATEWAY_OLLAMA_MODEL=qwen2.5:1.5b
GATEWAY_PROVIDER_TIMEOUT_SECONDS=120

# Request and model resource limits
GATEWAY_MAX_REQUEST_BODY_BYTES=32768
GATEWAY_MAX_MESSAGE_CHARS=8000
GATEWAY_MAX_ESTIMATED_INPUT_TOKENS=2048
GATEWAY_MAX_OUTPUT_TOKENS=256
GATEWAY_MAX_PROVIDER_RESPONSE_BYTES=65536

# Concurrency
GATEWAY_MAX_CONCURRENT_GLOBAL=16
GATEWAY_MAX_CONCURRENT_PER_KEY=4

# Per-process rate limiting
GATEWAY_RATE_LIMIT_REQUESTS=30
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60
GATEWAY_RATE_LIMIT_MAX_TRACKED_KEYS=10000