# -----------------------------------------------------------------------------
# Runtime
# -----------------------------------------------------------------------------

GATEWAY_ENVIRONMENT=development
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8000
GATEWAY_LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# SQLite
# -----------------------------------------------------------------------------

GATEWAY_DATABASE_PATH=./data/gateway.db

# -----------------------------------------------------------------------------
# API-key security
# -----------------------------------------------------------------------------

# Used as an application-level secret when deriving API-key digests.
#
# This value MUST be replaced in any environment beyond disposable local
# development.
#
# Generate a suitable value with:
#
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#
GATEWAY_API_KEY_PEPPER=development-only-change-me

# -----------------------------------------------------------------------------
# Provider configuration
# -----------------------------------------------------------------------------

# Provider integration is introduced in a later batch.
# The value is nevertheless configuration-driven from the beginning.
GATEWAY_OLLAMA_BASE_URL=http://127.0.0.1:11434
GATEWAY_PROVIDER_TIMEOUT_SECONDS=30

# -----------------------------------------------------------------------------
# Resource policy defaults
# -----------------------------------------------------------------------------

# These settings establish the central configuration contract for later
# gateway resource-control batches.
#
# Enforcement is introduced incrementally in subsequent batches.

GATEWAY_MAX_REQUEST_BODY_BYTES=32768
GATEWAY_MAX_MESSAGE_CHARS=8000
GATEWAY_MAX_ESTIMATED_INPUT_TOKENS=2048
GATEWAY_MAX_OUTPUT_TOKENS=256
GATEWAY_MAX_PROVIDER_RESPONSE_BYTES=65536

GATEWAY_MAX_CONCURRENT_GLOBAL=16
GATEWAY_MAX_CONCURRENT_PER_KEY=4

GATEWAY_RATE_LIMIT_REQUESTS=30
GATEWAY_RATE_LIMIT_WINDOW_SECONDS=60